# The provider and backend blocks are generated by Terragrunt from root.hcl,
# so they are deliberately absent here. Running this module with bare tofu
# will not work, and is not meant to.

terraform {
  required_version = ">= 1.10"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}
